<resources>
    <style name="Theme.VsLauncher" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.VsLauncher.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="android:colorControlNormal">#FFFFFF</item>
        <item name="android:colorControlActivated">#FFFFFF</item>
        <item name="android:listDivider">#FFFFFF</item>
        <item name="android:windowNoTitle">false</item>
    </style>
</resources>
